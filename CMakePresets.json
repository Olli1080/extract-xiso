{
	"version": 7,
	"cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}"
			}
		},
		{
			"name": "default",
			"displayName": "Ninja Multi-Config",
			"inherits": "base",
			"generator": "Ninja Multi-Config",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "tests",
			"displayName": "Ninja Multi-Config with tests",
			"inherits": "default",
			"cacheVariables": {
				"XISO_BUILD_TESTS": "ON"
			}
		},
		{
			"name": "vs2026",
			"displayName": "Visual Studio 2026",
			"inherits": "base",
			"generator": "Visual Studio 18 2026",
			"architecture": "x64",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		},
		{
			"name": "vs2026-tests",
			"displayName": "Visual Studio 2026 with tests",
			"inherits": "vs2026",
			"cacheVariables": {
				"XISO_BUILD_TESTS": "ON"
			}
		},
		{
			"name": "vs2022",
			"displayName": "Visual Studio 2022",
			"inherits": "base",
			"generator": "Visual Studio 17 2022",
			"architecture": "x64",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		}
	],
	"buildPresets": [
		{ "name": "default-debug", "configurePreset": "default", "configuration": "Debug" },
		{ "name": "default-release", "configurePreset": "default", "configuration": "Release" },
		{ "name": "tests-debug", "configurePreset": "tests", "configuration": "Debug" },
		{ "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" },
		{ "name": "vs2026-tests-debug", "configurePreset": "vs2026-tests", "configuration": "Debug" }
	],
	"testPresets": [
		{
			"name": "tests-debug",
			"configurePreset": "tests",
			"configuration": "Debug",
			"output": { "outputOnFailure": true }
		},
		{
			"name": "vs2026-tests-debug",
			"configurePreset": "vs2026-tests",
			"configuration": "Debug",
			"output": { "outputOnFailure": true }
		}
	]
}
