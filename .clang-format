---
Language:        Cpp
BasedOnStyle:    LLVM

# Braces on their own line
BreakBeforeBraces: Allman

# Omit braces for single-line if/else/while/for
RemoveBracesLLVM: true

# Indentation and Tabs
UseTab:          Always
TabWidth:        4
IndentWidth:     4
ContinuationIndentWidth: 4

# Alignment (Type-centric)
PointerAlignment: Left
QualifierAlignment: Left

# Namespace Indentation
NamespaceIndentation: None
CompactNamespaces: true
BreakTemplateDeclarations: MultiLine

# Newline management
InsertNewlineAtEOF: false
KeepEmptyLines:
  AtEndOfFile: false
  AtStartOfBlock: false
  AtStartOfFile: false

# Include Ordering
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '.*pch\.h'
    Priority:        0
  - Regex:           '^<winsock2\.h>'
    Priority:        1
    SortPriority:    1
  - Regex:           '^<windows\.h>'
    Priority:        1
    SortPriority:    2
  - Regex:           '^<(algorithm|any|array|atomic|barrier|bit|bitset|charconv|chrono|codecvt|compare|complex|concepts|condition_variable|coroutine|deque|exception|execution|filesystem|flat_map|flat_set|format|forward_list|fstream|functional|future|generator|initializer_list|iomanip|ios|iosfwd|iostream|istream|iterator|latch|limits|list|locale|map|memory|mutex|new|numbers|numeric|optional|ostream|print|queue|random|ranges|ratio|regex|scoped_allocator|semaphore|set|shared_mutex|source_location|span|sstream|stack|stacktrace|stdexcept|stdfloat|stop_token|streambuf|string|string_view|strstream|syncstream|system_error|thread|tuple|typeindex|typeinfo|type_traits|unordered_map|unordered_set|utility|valarray|variant|vector|version|c[a-z0-9_]+)>'
    Priority:        2
  - Regex:           '^<.*'
    Priority:        3
  - Regex:           '.*'
    Priority:        4

# Token-Saving Layout
ColumnLimit:     120
AlignAfterOpenBracket: Align
BinPackArguments: false
BinPackParameters: false
PackConstructorInitializers: NextLine
ConstructorInitializerAllOnOneLineOrOnePerLine: true
AllowShortBlocksOnASingleLine: Empty
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: WithoutElse 
AllowShortLoopsOnASingleLine: true
AllowShortCompoundRequirementOnASingleLine: true
PenaltyReturnTypeOnItsOwnLine: 1000000
AllowShortEnumsOnASingleLine: true
AllowShortLambdasOnASingleLine: All
AllowShortNamespacesOnASingleLine: true
AlwaysBreakBeforeMultilineStrings: true
BreakAfterAttributes: Never
LambdaBodyIndentation: Signature

# Minimize boilerplate noise
AccessModifierOffset: -4